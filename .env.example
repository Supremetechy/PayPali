# PayPali configuration. Copy to .env and fill in. `npm start`, `npm run stack` and `npm run paypal:smoke` read it.

# --- PayPal (developer.paypal.com → Apps & Credentials → Sandbox → your app) ---------------------------
# Without these, PayPali runs with a local page standing in for PayPal (no real money, clearly labelled).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                      # sandbox | production
# Optional: a sandbox PERSONAL account email to receive smoke-test and demo payouts.
PAYPAL_SANDBOX_PAYOUT_RECEIVER=
PAYPAL_SANDBOX_BENEFICIARY=
# PAYPALI_KYC_PROVIDER=paypal           # once "Log in with PayPal" is enabled on the app (return URL: <public url>/api/kyc/paypal/callback)

# --- Server -------------------------------------------------------------------------------------------
# PAYPALI_PUBLIC_URL=http://localhost:4000   # PayPal returns owners here after they approve a payment
# PORT=4000

# --- Data ---------------------------------------------------------------------------------------------
# npm start keeps data in .data/db (PGlite on disk) and secrets in .data/secrets.json.
# PAYPALI_DATA_DIR=.data/db
# PAYPALI_DATABASE_URL=postgres://user:pass@host:5432/paypali   # use an external Postgres instead

# --- Safety (npm start turns these on) ----------------------------------------------------------------
# PAYPALI_REQUIRE_SESSION=1              # owner and agent routes need the signed-in owner
# PAYPALI_REQUIRE_POWER_OF_AGENCY=1      # agents need a signed Power of Agency to move money
# PAYPALI_DATA_REQUIRE_KYC=1             # only identity-verified owners may sell data

# --- Multi-tenant exposure ----------------------------------------------------------------------------
# PAYPALI_MCP_ALLOWED_ORIGINS=https://app.example.com   # browser origins allowed to call /mcp (server-to-server is always allowed)
# PAYPALI_MCP_RATE_PER_MIN=240          # per-connection request cap on /mcp (0 disables)
# PAYPALI_OAUTH_RATE_PER_MIN=40         # per-IP cap on the OAuth write endpoints (0 disables)
# PAYPALI_PORTAL_WEBHOOK_SECRET=        # HMAC secret for POST /api/portals/confirm (settles PENDING_PROVIDER orders)

# --- Legal / commercial wrapper (served at /legal/terms and /legal/privacy) ----------------------------
# PAYPALI_LEGAL_ENTITY="Acme Payments, Inc."     # the operating entity named in the Terms and Privacy Policy
# PAYPALI_LEGAL_CONTACT=legal@example.com         # contact address shown in those documents

# --- Secrets as files (Docker/K8s) --------------------------------------------------------------------
# Any secret above can instead be delivered as a file by setting <NAME>_FILE to its path; the plain var
# always wins. Example (a Docker/Compose secret mounted at /run/secrets/paypal_client_secret):
# PAYPAL_CLIENT_SECRET_FILE=/run/secrets/paypal_client_secret

# Prisma CLI only (never used at runtime).
DATABASE_URL="postgresql://user:pass@localhost:5432/paypali?schema=public"
